# Telegram Bot Token (@BotFather dan olingan token)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Admin Telegram ID lari (vergul bilan ajratilgan)
ADMIN_IDS=123456789,987654321

# Admin panel uchun 4 xonali maxfiy PIN kod
ADMIN_PIN=7777

# WebApp joylashgan HTTPS manzil (Railway da berilgan domen: masalan https://xxxx.up.railway.app)
WEBAPP_URL=https://your-app-name.up.railway.app

# Server sozlamalari (Railway o'zi avtomatik o'rnatadi, o'zgartirish shart emas)
PORT=8000
HOST=0.0.0.0
